{
  "manifest_version": 3,
  "name": "Gutter",
  "version": "1.0",
  "description": "Context without clutter. Alt+Click any heading for instant context — no new tabs, no rabbit holes.",
  "permissions": ["activeTab", "storage"],
  "options_page": "options.html",
  "icons": { "128": "icon128.png" },
  "action": { "default_icon": { "128": "icon128.png" } },
  "host_permissions": [
    "https://gutter-api.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
